
#include <stdio.h>
#include <stdlib.h>

#define MAX 32

typedef struct {
    int itens[MAX];
    int topo;
} Pilha;

// Inicializa a pilha como vazia.
void iniciarPilha(Pilha *p) {
    p->topo = -1;
}

// Insere um valor no topo da pilha.
void empilhar(Pilha *p, int valor) {
    if (p->topo == MAX - 1) {
        printf("\n[ERRO] A pilha esta cheia!\n");
    } else {
        p->topo++;
        p->itens[p->topo] = valor;
    }
}

// Remove e retorna o valor do topo da pilha.
int desempilhar(Pilha *p, int *valor) {
    if (p->topo == -1) {
        printf("\n[ERRO] A pilha esta vazia!\n");
        return 0;
    } else {
        *valor = p->itens[p->topo];
        p->topo--;
        return 1;
    }
}

int main() {
    Pilha minhaPilha;
    int numero, valor;

    iniciarPilha(&minhaPilha);

    // Solicita um número inteiro não negativo.
    do {
        printf("Digite um numero inteiro nao negativo: ");
        scanf("%d", &numero);

        if (numero < 0) {
            printf("[ERRO] Numero negativo nao permitido!\n");
        }
    } while (numero < 0);

    // Trata o zero, cuja representação binária é 0.
    if (numero == 0) {
        empilhar(&minhaPilha, 0);
    } else {
        // Empilha os restos das divisões sucessivas por dois.
        while (numero > 0) {
            empilhar(&minhaPilha, numero % 2);
            numero = numero / 2;
        }
    }

    // Desempilha os restos para apresentar o binário na ordem correta.
    printf("\nRepresentacao binaria: ");

    while (desempilhar(&minhaPilha, &valor)) {
        printf("%d", valor);
    }

    printf("\n");

    return 0;
}
