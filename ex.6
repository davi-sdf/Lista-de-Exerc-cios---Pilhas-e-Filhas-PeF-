
#include <stdio.h>
#include <stdlib.h>

#define MAX 5

typedef struct {
    int itens[MAX];
    int inicio;
    int fim;
} Fila;

// Inicializa a fila como vazia.
void iniciarFila(Fila *f) {
    f->inicio = 0;
    f->fim = 0;
}

// Insere um elemento no final da fila.
void enfileirar(Fila *f, int valor) {
    if (f->fim == MAX) {
        printf("\n[ERRO] A fila esta cheia!\n");
    } else {
        f->itens[f->fim] = valor;
        f->fim++;
        printf("\n[SUCESSO] %d entrou na fila!\n", valor);
    }
}

// Remove o primeiro elemento da fila.
void desenfileirar(Fila *f) {
    if (f->inicio == f->fim) {
        printf("\n[ERRO] A fila esta vazia!\n");
    } else {
        printf("\n[SUCESSO] %d saiu da fila!\n", f->itens[f->inicio]);
        f->inicio++;
    }
}

// Consulta o primeiro elemento sem removê-lo.
void consultarProximo(Fila *f) {
    if (f->inicio == f->fim) {
        printf("\nA fila esta vazia!\n");
    } else {
        printf("\nProximo elemento: %d\n", f->itens[f->inicio]);
    }
}

// Calcula a quantidade utilizando inicio e fim.
void mostrarQuantidade(Fila *f) {
    printf("\nQuantidade de elementos: %d\n", f->fim - f->inicio);
}

// Mostra todos os elementos da fila.
void mostrarFila(Fila *f) {
    if (f->inicio == f->fim) {
        printf("\nA fila esta vazia.\n");
    } else {
        printf("\n--- ESTADO ATUAL DA FILA ---\n");
        for (int i = f->inicio; i < f->fim; i++) {
            printf("[%d] ", f->itens[i]);
        }
        printf("\n");
    }
}

int main() {
    Fila minhaFila;
    int opcao, valor;

    iniciarFila(&minhaFila);

    do {
        printf("\n=== MENU FILA (FIFO) ===\n");
        printf("1. Enfileirar\n");
        printf("2. Desenfileirar\n");
        printf("3. Mostrar fila\n");
        printf("4. Consultar proximo elemento\n");
        printf("5. Mostrar quantidade de elementos\n");
        printf("0. Sair\n");
        printf("Escolha uma opcao: ");
        scanf("%d", &opcao);

        switch (opcao) {
            case 1:
                printf("Digite o valor: ");
                scanf("%d", &valor);
                enfileirar(&minhaFila, valor);
                break;

            case 2:
                desenfileirar(&minhaFila);
                break;

            case 3:
                mostrarFila(&minhaFila);
                break;

            case 4:
                consultarProximo(&minhaFila);
                break;

            case 5:
                mostrarQuantidade(&minhaFila);
                break;

            case 0:
                printf("Saindo...\n");
                break;

            default:
                printf("Opcao invalida!\n");
        }

    } while (opcao != 0);

    return 0;
}
